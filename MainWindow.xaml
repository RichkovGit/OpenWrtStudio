<ui:FluentWindow x:Class="OpenWrtStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:OpenWrtStudio.Views"
        mc:Ignorable="d"
        Title="OpenWrt Studio" Height="820" Width="1240"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <!-- Fluent Navigation Sidebar RadioButton Style -->
        <Style x:Key="SidebarNavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="MainNavigationGroup" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="8,8,12,8" Background="Transparent" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Windows 11 Active Accent Pill Indicator -->
                                <Border x:Name="ActivePill" Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left" Margin="0,0,8,0" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentPresenter ContentSource="Content" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActivePill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="OpenWrt Studio - Центр управления, Диагностика и Конструктор Mihomo"
                     Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <!-- Top Connection Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Router24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Роутер:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ComboBox Width="240" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Link24}" Content="Подключить" 
                               Command="{Binding ConnectCommand}" Margin="0,0,6,0"
                               Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}}" />
                    <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon LinkDismiss24}" Content="Отключить" 
                               Command="{Binding DisconnectCommand}" 
                               Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!-- Status Text & Busy Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding BusyStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Router Host Label & Mode Switcher -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Mode Switcher Pill (Simple / Expert) -->
                    <Border CornerRadius="16" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="2" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="{Binding IsExpertMode, Converter={StaticResource InverseBoolToAppearanceConverter}}"
                                       Content="⚡ Простой" Padding="10,4"
                                       Command="{Binding EnableSimpleModeCommand}" />
                            <ui:Button Appearance="{Binding IsExpertMode, Converter={StaticResource BoolToAppearanceConverter}}"
                                       Content="🛠️ Эксперт" Padding="10,4"
                                       Command="{Binding EnableExpertModeCommand}" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Padding="10,3" Margin="0,0,12,0" Background="#10B981"
                            Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ConnectedHost, StringFormat='Онлайн: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- SENTINEL WATCHDOG AUTO-HEALING BANNER -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="#EF4444" BorderThickness="0,0,0,2" Padding="16,12"
                Visibility="{Binding HasActiveIssue, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.RowSpan="2" Symbol="Warning24" FontSize="36" Foreground="#EF4444" Margin="0,0,16,0" VerticalAlignment="Center" />

                <!-- Issue Details -->
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ActiveIssue.Title, StringFormat='Обнаружен сбой: {0}'}" FontSize="16" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,12,0" />
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="{Binding ActiveIssue.ProviderStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveIssue.Description}" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <ui:Button Grid.Row="0" Grid.Column="2" Appearance="Secondary" Content="✕ Скрыть" Command="{Binding DismissIssueCommand}" VerticalAlignment="Top" />

                <!-- Recovery Methods Buttons -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Предложенные варианты решения:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
                    <ItemsControl ItemsSource="{Binding ActiveIssue.RecoveryMethods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Appearance="Primary" Content="{Binding Name}" Margin="0,0,8,0"
                                           Command="{Binding DataContext.ApplyHealingMethodCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                           CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Navigation Sidebar -->
        <Grid Grid.Row="3" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="10,16,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <!-- 0: Дашборд -->
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Дашборд" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 1: Клиенты сети -->
                        <RadioButton x:Name="NavClients" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PeopleCommunity24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Клиенты сети" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2: Управление роутером (Expert) -->
                        <RadioButton x:Name="NavRouter" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     Visibility="{Binding IsExpertMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=2, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Router24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Управление роутером" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 3: VPN Протоколы (Expert) -->
                        <RadioButton x:Name="NavVpn" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     Visibility="{Binding IsExpertMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=3, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="VPN Протоколы" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 4: Конструктор Mihomo (Expert) -->
                        <RadioButton x:Name="NavMihomo" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     Visibility="{Binding IsExpertMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=4, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Конструктор Mihomo" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 5: ForkOP & Обход (Expert) -->
                        <RadioButton x:Name="NavForkop" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     Visibility="{Binding IsExpertMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=5, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Earth24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="ForkOP &amp; Обход" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 6: Расписания (Cron) (Expert) -->
                        <RadioButton x:Name="NavScheduler" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     Visibility="{Binding IsExpertMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=6, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Расписания (Cron)" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 7: Диагностика (Expert) -->
                        <RadioButton x:Name="NavDiag" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     Visibility="{Binding IsExpertMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=7, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Stethoscope24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Диагностика" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 8: Плагины и Темы (Expert) -->
                        <RadioButton x:Name="NavPackages" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     Visibility="{Binding IsExpertMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=8, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Плагины и Темы" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Footer: 9: Settings item -->
                    <RadioButton Grid.Row="1" x:Name="NavSettings" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                 IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=9, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="Настройки" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- Main Content Area Container (Guarantees single view rendering with zero overlap) -->
            <Border Grid.Column="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <TabControl 
                            SelectedIndex="{Binding SelectedNavIndex}"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" Margin="0" />
                    </ControlTemplate>
                </TabControl.Template>

                <!-- 0: Дашборд -->
                <TabItem>
                    <views:DashboardView DataContext="{Binding DashboardVM}" />
                </TabItem>
                <!-- 1: Клиенты сети -->
                <TabItem>
                    <views:ClientsView DataContext="{Binding ClientsVM}" />
                </TabItem>
                <!-- 2: Управление роутером -->
                <TabItem>
                    <views:RouterSettingsView DataContext="{Binding RouterSettingsVM}" />
                </TabItem>
                <!-- 3: VPN Протоколы -->
                <TabItem>
                    <views:VpnProtocolsView DataContext="{Binding VpnVM}" />
                </TabItem>
                <!-- 4: Конструктор Mihomo -->
                <TabItem>
                    <views:MihomoBuilderView DataContext="{Binding MihomoVM}" />
                </TabItem>
                <!-- 5: ForkOP & Обход -->
                <TabItem>
                    <views:ForkopView DataContext="{Binding ForkopVM}" />
                </TabItem>
                <!-- 6: Расписания (Cron) -->
                <TabItem>
                    <views:SchedulerView DataContext="{Binding SchedulerVM}" />
                </TabItem>
                <!-- 7: Диагностика -->
                <TabItem>
                    <views:DiagnosticsView DataContext="{Binding DiagnosticsVM}" />
                </TabItem>
                <!-- 8: Плагины и Темы -->
                <TabItem>
                    <views:PackagesView DataContext="{Binding PackagesVM}" />
                </TabItem>
                <!-- 9: Настройки -->
                <TabItem>
                    <views:SettingsView DataContext="{Binding SettingsVM}" />
                </TabItem>
            </TabControl>
        </Border>
    </Grid>

        <!-- Global Toast Notification Bar -->
        <ui:InfoBar Grid.Row="4" Title="Уведомление" Message="{Binding NotificationMessage}" 
                    IsOpen="{Binding ShowNotification}" 
                    Severity="Informational" 
                    Margin="16,8" />
    </Grid>
</ui:FluentWindow>
