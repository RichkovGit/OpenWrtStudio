<UserControl x:Class="OpenWrtStudio.Views.RouterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Управление роутером" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Полная конфигурация Wi-Fi 2.4/5GHz, локальной сети, пула DHCP, соединения WAN, проброса портов и системы" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Banner -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Обновить все настройки" Command="{Binding LoadAllConfigsCommand}" />
                </Grid>
            </Border>

            <!-- Navigation Tabs for Router Settings -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton Content="📶 Wi-Fi Сети" GroupName="RouterSubTabsGroup"
                             IsChecked="{Binding SelectedSectionIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0, Mode=TwoWay}"
                             Margin="0,0,10,0" />
                <RadioButton Content="🌐 LAN &amp; DHCP" GroupName="RouterSubTabsGroup"
                             IsChecked="{Binding SelectedSectionIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1, Mode=TwoWay}"
                             Margin="0,0,10,0" />
                <RadioButton Content="🔌 WAN &amp; PPPoE" GroupName="RouterSubTabsGroup"
                             IsChecked="{Binding SelectedSectionIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=2, Mode=TwoWay}"
                             Margin="0,0,10,0" />
                <RadioButton Content="🛡️ Проброс портов" GroupName="RouterSubTabsGroup"
                             IsChecked="{Binding SelectedSectionIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=3, Mode=TwoWay}"
                             Margin="0,0,10,0" />
                <RadioButton Content="⚙️ Система &amp; Бэкап" GroupName="RouterSubTabsGroup"
                             IsChecked="{Binding SelectedSectionIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=4, Mode=TwoWay}" />
            </StackPanel>

            <!-- SECTION 0: WI-FI -->
            <StackPanel Visibility="{Binding SelectedSectionIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Беспроводные сети Wi-Fi" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Настройка радиомодулей 2.4 GHz и 5 GHz, имен сетей (SSID), безопасности WPA2/WPA3 и паролей" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="Применить настройки Wi-Fi" Command="{Binding SaveWifiCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding WifiRadios}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Device, StringFormat='Радиомодуль: {0}'}" FontWeight="Bold" FontSize="14" Margin="0,0,10,0" />
                                                    <Border Background="#3B82F6" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Band}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <CheckBox HorizontalAlignment="Right" Content="Отключить этот радиомодуль" IsChecked="{Binding Disabled}" />
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="Канал (Channel)" FontSize="11" Margin="0,0,0,2" />
                                                    <ui:TextBox Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Ширина полосы (HT Mode)" FontSize="11" Margin="0,0,0,2" />
                                                    <ui:TextBox Text="{Binding HtMode, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Interfaces under this radio -->
                                            <ItemsControl ItemsSource="{Binding Interfaces}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="160" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Margin="0,0,8,0">
                                                                    <TextBlock Text="Имя сети (SSID)" FontSize="11" Margin="0,0,0,2" />
                                                                    <ui:TextBox Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                    <TextBlock Text="Шифрование" FontSize="11" Margin="0,0,0,2" />
                                                                    <ComboBox SelectedValue="{Binding Encryption, Mode=TwoWay}" SelectedValuePath="Tag">
                                                                        <ComboBoxItem Content="WPA2-PSK" Tag="psk2" IsSelected="True" />
                                                                        <ComboBoxItem Content="WPA3-SAE" Tag="sae" />
                                                                        <ComboBoxItem Content="WPA2/WPA3 Mixed" Tag="sae-mixed" />
                                                                        <ComboBoxItem Content="Без пароля (Open)" Tag="none" />
                                                                    </ComboBox>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="Пароль от Wi-Fi" FontSize="11" Margin="0,0,0,2" />
                                                                    <ui:TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- SECTION 1: LAN & DHCP -->
            <StackPanel Visibility="{Binding SelectedSectionIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}">
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Параметры локальной сети (LAN) и DHCP" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="IP-адрес роутера, маска подсети и диапазон автоматической раздачи адресов" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="Сохранить параметры сети" Command="{Binding SaveLanCommand}" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="IP-адрес роутера" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding LanConfig.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Маска подсети" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding LanConfig.Netmask, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Начало пула" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding LanConfig.DhcpStart, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Количество IP" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding LanConfig.DhcpLimit, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Время аренды" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding LanConfig.LeaseTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Статические IP адреса по MAC (Static Leases)" FontWeight="SemiBold" Margin="0,10,0,8" />
                        
                        <!-- Static Leases List -->
                        <ItemsControl ItemsSource="{Binding StaticLeases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Mac}" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Ip}" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <ui:Button Grid.Column="3" Appearance="Danger" Content="✕" Padding="6,2" 
                                                       Command="{Binding DataContext.DeleteStaticLeaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Lease Row -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Margin="0,0,8,0" PlaceholderText="Имя устройства" Text="{Binding NewLeaseName, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox Grid.Column="1" Margin="0,0,8,0" PlaceholderText="MAC (AA:BB:CC:DD:EE:FF)" Text="{Binding NewLeaseMac, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox Grid.Column="2" Margin="0,0,8,0" PlaceholderText="IP адрес (192.168.1.50)" Text="{Binding NewLeaseIp, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="3" Appearance="Secondary" Icon="{ui:SymbolIcon Add24}" Content="Добавить" Command="{Binding AddStaticLeaseCommand}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- SECTION 2: WAN -->
            <StackPanel Visibility="{Binding SelectedSectionIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2}">
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Подключение к интернету (WAN)" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Авторизация PPPoE, автоматический клиент DHCP или статический IP от провайдера" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="Сохранить настройки WAN" Command="{Binding SaveWanCommand}" />
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Протокол подключения" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding WanConfig.Proto, Mode=TwoWay}" SelectedValuePath="Tag" Width="240" HorizontalAlignment="Left">
                                <ComboBoxItem Content="PPPoE (Логин и пароль)" Tag="pppoe" />
                                <ComboBoxItem Content="DHCP клиент (Автоматический IP)" Tag="dhcp" />
                                <ComboBoxItem Content="Статический IP адрес" Tag="static" />
                            </ComboBox>
                        </StackPanel>

                        <!-- PPPoE fields -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Логин PPPoE" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding WanConfig.PppoeUsername, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Пароль PPPoE" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding WanConfig.PppoePassword, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MTU (Обычно 1492)" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding WanConfig.Mtu, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- SECTION 3: FIREWALL & PORT FORWARDING -->
            <StackPanel Visibility="{Binding SelectedSectionIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=3}">
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Проброс портов (Port Forwarding / DNAT)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        
                        <ItemsControl ItemsSource="{Binding PortForwards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Proto}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding SrcPort, StringFormat='Порт: {0}'}" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding DestIp, StringFormat='Назначение: {0}'}" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding DestPort, StringFormat='Внутр. порт: {0}'}" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <ui:Button Grid.Column="5" Appearance="Danger" Content="Удалить" Padding="6,2" 
                                                       Command="{Binding DataContext.DeletePortForwardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Rule Form -->
                        <TextBlock Text="Добавить новое правило проброса" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Margin="0,0,6,0" PlaceholderText="Имя (e.g. Web)" Text="{Binding NewRule.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="1" Margin="0,0,6,0" SelectedValue="{Binding NewRule.Proto, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="TCP" Tag="tcp" IsSelected="True" />
                                <ComboBoxItem Content="UDP" Tag="udp" />
                                <ComboBoxItem Content="TCP+UDP" Tag="tcp udp" />
                            </ComboBox>
                            <ui:TextBox Grid.Column="2" Margin="0,0,6,0" PlaceholderText="Внешний порт" Text="{Binding NewRule.SrcPort, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox Grid.Column="3" Margin="0,0,6,0" PlaceholderText="Целевой IP в LAN" Text="{Binding NewRule.DestIp, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox Grid.Column="4" Margin="0,0,6,0" PlaceholderText="Внутренний порт" Text="{Binding NewRule.DestPort, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="5" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Добавить" Command="{Binding AddPortForwardCommand}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- SECTION 4: SYSTEM & BACKUP -->
            <StackPanel Visibility="{Binding SelectedSectionIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=4}">
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Системное администрирование" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Смена пароля администратора root, имени роутера, часового пояса и экспорт резервной копии" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="Сохранить настройки" Command="{Binding SaveSystemCommand}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Имя устройства (Hostname)" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding SystemConfig.Hostname, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Часовой пояс (Timezone)" FontSize="11" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding SystemConfig.Timezone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Новый пароль root (оставьте пустым, если не нужно менять)" FontSize="11" Margin="0,0,0,2" />
                            <ui:TextBox Text="{Binding SystemConfig.NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Backup Download Button -->
                        <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="14" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Полная резервная копия настроек (sysupgrade.tar.gz)" FontWeight="SemiBold" />
                                    <TextBlock Text="Скачивает все конфигурационные файлы /etc/config, SSH ключи и сетевые параметры роутера на ваш компьютер." 
                                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Скачать бэкап на ПК" Command="{Binding DownloadBackupCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
