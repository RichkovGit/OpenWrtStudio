<UserControl x:Class="OpenWrtStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Настройки и Профили роутеров" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Управление параметрами подключения, закрытыми ключами SSH и персонализацией приложения" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Profiles Card -->
            <ui:Card Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Профили подключения OpenWrt" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <!-- Profiles List -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CurrentEditingProfile}" 
                                 DisplayMemberPath="Name" Height="220" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Новый" Command="{Binding AddNewProfileCommand}" Margin="0,0,8,0" />
                            <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Content="Удалить" Command="{Binding DeleteProfileCommand}" CommandParameter="{Binding CurrentEditingProfile}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Profile Form -->
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Название профиля" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding CurrentEditingProfile.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Порт SSH" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding CurrentEditingProfile.Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="IP-адрес или Хост" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding CurrentEditingProfile.Host, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Имя пользователя (Логин)" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding CurrentEditingProfile.Username, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Пароль root" Margin="0,0,0,4" />
                            <ui:PasswordBox Password="{Binding CurrentEditingProfile.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <ui:ToggleSwitch Content="Использовать закрытый ключ SSH (Key Auth)" IsChecked="{Binding CurrentEditingProfile.UseKeyAuth}" Margin="0,0,0,6" />
                            <Grid Visibility="{Binding CurrentEditingProfile.UseKeyAuth, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding CurrentEditingProfile.PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Путь к файлу ключа (id_rsa, id_ed25519)" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="1" Appearance="Secondary" Content="Обзор..." Command="{Binding SelectPrivateKeyCommand}" />
                            </Grid>
                        </StackPanel>

                        <ui:ToggleSwitch Content="Подключаться автоматически при запуске" IsChecked="{Binding CurrentEditingProfile.AutoConnectOnStartup}" Margin="0,0,0,14" />

                        <!-- Action buttons inside form -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Checkmark24}" Content="Проверить связь" 
                                       Command="{Binding TestConnectionCommand}" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Сохранить профили" 
                                       Command="{Binding SaveProfilesCommand}" />

                            <TextBlock Grid.Column="2" Text="{Binding TestStatus}" VerticalAlignment="Center" Margin="12,0,0,0" 
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Appearance & Theme Card -->
            <ui:Card Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Персонализация и Цветовые Схемы" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Выберите акцентную палитру и режим отображения интерфейса (Fluent Design)" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ToggleSwitch Content="Тёмная тема" IsChecked="{Binding IsDarkMode}" 
                                             Command="{Binding ToggleThemeCommand}" Margin="0,0,12,0" />
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon DarkTheme24}" 
                                       Content="Сменить режим" Command="{Binding ToggleThemeCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Color Palettes Grid -->
                    <TextBlock Text="Акцентные цветовые палитры:" FontWeight="Medium" Margin="0,4,0,8" />
                    <ItemsControl ItemsSource="{Binding ColorThemes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" CornerRadius="8" Padding="10" 
                                        BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToThicknessConverter}, FallbackValue=1}"
                                        BorderBrush="{Binding Brush}"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Swatch circle -->
                                        <Ellipse Width="24" Height="24" Fill="{Binding Brush}" Margin="0,0,10,0" VerticalAlignment="Center" />

                                        <!-- Text info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Select Button -->
                                        <Button Grid.Column="2" Padding="8,4" Margin="6,0,0,0"
                                                Content="{Binding IsSelected, Converter={StaticResource BoolToSelectedTextConverter}, FallbackValue='Выбрать'}"
                                                Command="{Binding DataContext.SelectColorThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ThemeStatusText}" Margin="0,8,0,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium"
                               Visibility="{Binding ThemeStatusText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" />
                </StackPanel>
            </ui:Card>

            <!-- Card 3: OTA Updates (GitHub Releases) -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Обновления программы (OTA GitHub Releases)" FontSize="16" FontWeight="SemiBold" />
                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding CurrentAppVersionString}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Автоматическая проверка и установка свежих версий напрямую из репозитория RichkovGit/OpenWrtStudio" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Globe24}" Content="GitHub Репозиторий" 
                                       Command="{Binding OpenGitHubRepoCommand}" Margin="0,0,8,0" />
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Проверить обновления" 
                                       Command="{Binding CheckForUpdatesCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Status / Progress row -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="14,12" Margin="0,4,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0"
                                                     Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding UpdateStatusText}" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>

                                <ui:Button Grid.Column="1" Appearance="Success" Icon="{ui:SymbolIcon ArrowDownload24}" 
                                           Content="Скачать и обновить" Command="{Binding DownloadAndApplyUpdateCommand}"
                                           Visibility="{Binding UpdateInfo.IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <!-- Changelog display when update found -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding UpdateInfo.IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Что нового в этой версии:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding UpdateInfo.Changelog}" TextWrapping="Wrap" MaxHeight="120"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Download Progress bar -->
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="8" />
                                <TextBlock Text="{Binding DownloadProgress, StringFormat='Загрузка обновления: {0}%'}" FontSize="11" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Auto check switch -->
                            <ui:ToggleSwitch Content="Проверять обновления автоматически при запуске OpenWrt Studio" 
                                             IsChecked="{Binding AutoCheckUpdates}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
