<UserControl x:Class="OpenWrtStudio.Views.SchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Расписания &amp; Планировщик задач (Cron)" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Автоматизация работы роутера: ночное отключение Wi-Fi, периодическая перезагрузка, авто-обновление подписок и очистка кэша" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Banner -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Play24}" Content="Включить службу cron" Command="{Binding EnableCronServiceCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding IsCronRunning, Converter={StaticResource InverseBooleanConverter}}" />
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Обновить" Command="{Binding LoadJobsCommand}" Margin="0,0,8,0" />
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="Сохранить на роутере" Command="{Binding SaveJobsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 1: Ready Presets (1-Click) -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Готовые сценарии автоматизации (в 1 клик)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <WrapPanel>
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Power24}" Content="🌙 Ночная перезагрузка (04:00)" 
                                   Command="{Binding AddNightRebootPresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon WeatherMoon24}" Content="📴 Отключение Wi-Fi на ночь (01:00-07:00)" 
                                   Command="{Binding AddNightWifiOffPresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" Content="🚀 Авто-обновление подписок (каждые 6ч)" 
                                   Command="{Binding AddSubUpdatePresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Broom24}" Content="🧹 Очистка кэша памяти (03:00)" 
                                   Command="{Binding AddDropCachesPresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon HeartPulse24}" Content="📡 Сторож пинга (Watchdog)" 
                                   Command="{Binding AddPingWatchdogPresetCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <!-- Card 2: Active Crontab Jobs -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Список задач планировщика (/etc/crontabs/root)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Schedule}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="12" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Play24}" Content="Тест" Margin="0,0,6,0" Padding="8,4"
                                                       Command="{Binding DataContext.ExecuteNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Appearance="Danger" Content="✕" Padding="8,4"
                                                       Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Card 3: Add Custom Job -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Добавить собственную задачу" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Расписание (минута час день месяц день_недели)" FontSize="11" Margin="0,0,0,2" />
                            <ui:TextBox Text="{Binding NewSchedule, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="* * * * *" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Команда Linux" FontSize="11" Margin="0,0,0,2" />
                            <ui:TextBox Text="{Binding NewCommand, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="/etc/init.d/network restart" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Описание задачи" FontSize="11" Margin="0,0,0,2" />
                            <ui:TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Перезапуск сети" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Добавить задачу" Command="{Binding AddCustomJobCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
