<UserControl x:Class="OpenWrtStudio.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Магазин плагинов, Темы и VPN протоколы" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Поиск по интернету, каталог тем оформления и репозиториев (ForkOP, PassWall 2, AmneziaWG, Sing-box, Mihomo, Tailscale)" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Обновить opkg списки" 
                           Command="{Binding UpdateListsCommand}" IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBooleanConverter}}" />
            </StackPanel>
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="1">
            <!-- TAB 1: Поиск в Интернете -->
            <TabItem Header="🔍 Поиск плагинов в Интернете">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="Поиск плагина или VPN в интернете (например: amneziawg, sing-box, forkop, argon, passwall, wireguard)...">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchOnlineCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>

                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Content="Искать в Интернете" Command="{Binding SearchOnlineCommand}" />
                        </Grid>
                    </ui:Card>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ui:InfoBar Title="Статус поиска" Message="{Binding StatusMessage}" 
                                        IsOpen="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                        Severity="Informational" Margin="0,0,0,14" />

                            <ItemsControl ItemsSource="{Binding OnlineSearchResults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Width="430" Margin="0,0,14,14">
                                            <Grid Height="120">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ui:SymbolIcon Grid.RowSpan="2" Symbol="Globe24" FontSize="32" 
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0" />

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Border Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{Binding SourceRepo}" FontSize="10" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />

                                                <!-- Description -->
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" 
                                                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                                <!-- Action Button -->
                                                <ui:Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" HorizontalAlignment="Right"
                                                           Appearance="Primary" Content="Установить на роутер" 
                                                           Command="{Binding DataContext.InstallOnlinePackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2: Рекомендованный каталог -->
            <TabItem Header="Каталог тем и плагинов">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding CuratedPackages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Width="430" Margin="0,0,14,14">
                                        <Grid Height="115">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Grid.RowSpan="2" Symbol="Apps24" FontSize="32" 
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
                                                <Border HorizontalAlignment="Left" Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4" Padding="6,1" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Status Tag -->
                                            <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"
                                                    Background="#10B981"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Установлен" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                            </Border>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" 
                                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                            <!-- Action Button -->
                                            <ui:Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" HorizontalAlignment="Right"
                                                       Appearance="Primary" Content="Установить в 1 клик" 
                                                       Command="{Binding DataContext.InstallPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Установленные на роутере -->
            <TabItem Header="Установленные пакеты">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Пакеты, установленные в файловой системе OpenWrt:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Обновить список" Command="{Binding LoadInstalledCommand}" />
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Row="1">
                        <DataGrid ItemsSource="{Binding InstalledPackages}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  RowHeight="36" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя пакета" Binding="{Binding Name}" Width="250" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Установленная версия" Binding="{Binding Version}" Width="160" />
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="180" />
                                <DataGridTemplateColumn Header="Удалить" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Appearance="Danger" Content="Удалить" 
                                                       Command="{Binding DataContext.RemovePackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- TAB 4: Кастомные репозитории (Feeds) -->
            <TabItem Header="Кастомные репозитории (Feeds / ForkOP)">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Добавить сторонний репозиторий (ForkOP, Sirpdboy, ImmortalWrt)" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding NewFeedName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Имя источника (например forkop)" Margin="0,0,8,0" />
                                <ui:TextBox Grid.Column="1" Text="{Binding NewFeedUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="URL репозитория (http://...)" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="2" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Добавить" Command="{Binding AddFeedCommand}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1">
                        <DataGrid ItemsSource="{Binding CustomFeeds}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  RowHeight="36" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="180" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="URL репозитория" Binding="{Binding Url}" Width="*" />
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="250" />
                                <DataGridTemplateColumn Header="Удалить" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Appearance="Danger" Content="Удалить" 
                                                       Command="{Binding DataContext.RemoveFeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
