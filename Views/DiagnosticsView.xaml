<UserControl x:Class="OpenWrtStudio.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Устранение неполадок и Диагностика" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Интеллектуальный поиск проблем сети, аудит памяти и служб, анализ журналов и тесты" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Diagnostics Tabs -->
        <TabControl Grid.Row="1">
            <!-- TAB 1: Доктор роутера -->
            <TabItem Header="Доктор роутера (Аудит)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <ui:Card Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Автоматическая диагностика" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AuditSummary}" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Stethoscope24}" 
                                           Content="Запустить аудит" Command="{Binding RunHealthAuditCommand}" />
                            </Grid>
                        </ui:Card>

                        <!-- Items List -->
                        <ItemsControl ItemsSource="{Binding HealthItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Icon -->
                                            <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Status, Converter={StaticResource HealthStatusToBrushConverter}}" 
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                                <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource HealthStatusToIconConverter}}" 
                                                               Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                    <Border Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding StatusText}" FontWeight="Medium" Foreground="{Binding Status, Converter={StaticResource HealthStatusToBrushConverter}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Recommendation, StringFormat='Совет: {0}'}" 
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- One-Click Fix Button -->
                                            <ui:Button Grid.Column="2" Appearance="Caution" Content="Исправить в 1 клик" 
                                                       Icon="{ui:SymbolIcon Wrench24}" VerticalAlignment="Center"
                                                       Visibility="{Binding CanAutoFix, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Command="{Binding DataContext.FixIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Ping & Traceroute -->
            <TabItem Header="Ping и Трассировка">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Ping Section -->
                    <ui:Card Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Проверка задержки (Ping)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Хост или IP (например 1.1.1.1, ya.ru)" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <ui:Button Appearance="Primary" Content="Старт" Command="{Binding StartPingCommand}" IsEnabled="{Binding IsPinging, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,6,0" />
                                        <ui:Button Appearance="Secondary" Content="Стоп" Command="{Binding StopPingCommand}" IsEnabled="{Binding IsPinging}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding PingSummary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding PingResults}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                      RowHeight="30" BorderThickness="0" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="40" />
                                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120" />
                                    <DataGridTextColumn Header="Время (мс)" Binding="{Binding TimeMs, StringFormat='{}{0:F1} ms'}" Width="100" />
                                    <DataGridTextColumn Header="Ответ" Binding="{Binding RawText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ui:Card>

                    <!-- Traceroute Section -->
                    <ui:Card Grid.Column="1" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Трассировка маршрута (Traceroute)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding TraceHost, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Хост назначения" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <ui:Button Appearance="Primary" Content="Трассировать" Command="{Binding StartTracerouteCommand}" IsEnabled="{Binding IsTracing, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,6,0" />
                                        <ui:Button Appearance="Secondary" Content="Стоп" Command="{Binding StopTracerouteCommand}" IsEnabled="{Binding IsTracing}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding TraceHops}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                      RowHeight="30" BorderThickness="0" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Хост #" Binding="{Binding Hop}" Width="60" />
                                    <DataGridTextColumn Header="Узел / IP" Binding="{Binding Ip}" Width="140" />
                                    <DataGridTextColumn Header="RTT" Binding="{Binding Rtt1}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- TAB 3: Системный журнал -->
            <TabItem Header="Журнал событий (Logs)">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Системный (logread)" IsChecked="{Binding IsKernelLogSelected, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,12,0" />
                                <RadioButton Content="Ядро (dmesg)" IsChecked="{Binding IsKernelLogSelected}" />
                            </StackPanel>

                            <ui:TextBox Grid.Column="1" Margin="16,0" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="Поиск в журнале (фильтр по процессу, сообщению, ошибкам)..." />

                            <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Обновить логи" Command="{Binding RefreshLogsCommand}" />
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Row="1">
                        <DataGrid ItemsSource="{Binding FilteredLogs}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  RowHeight="28" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="130" />
                                <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="80" />
                                <DataGridTextColumn Header="Процесс" Binding="{Binding Process}" Width="120" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- TAB 4: SSH Консоль -->
            <TabItem Header="SSH Консоль">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,12" Background="#111827">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding TerminalOutput, Mode=OneWay}" 
                                     Background="Transparent" Foreground="#10B981" 
                                     BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" 
                                     FontSize="13" IsReadOnly="True" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </ui:Card>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Введите команду OpenWrt..." 
                                    FontFamily="Consolas, Cascadia Code">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ExecuteTerminalCommandCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>

                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" Content="Выполнить" 
                                   Command="{Binding ExecuteTerminalCommandCommand}" />
                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Appearance="Secondary" Content="Очистить" 
                                   Command="{Binding ClearTerminalCommand}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
