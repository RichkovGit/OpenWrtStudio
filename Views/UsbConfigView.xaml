<UserControl x:Class="OpenWrtStudio.Views.UsbConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1050">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Конфигурация USB (Модемы и Диски)" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Управление LTE/4G/5G USB-модемами (QMI, MBIM, NCM, RNDIS, 3G), точками монтирования накопителей (fstab) и общим доступом Samba" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Experimental Beta Notice Banner -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Warning24" FontSize="26" Foreground="#F59E0B" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="🧪 Экспериментальная тестовая функция (BETA)" FontWeight="SemiBold" FontSize="14" Foreground="#F59E0B" />
                        <TextBlock Text="Управление USB-устройствами предназначено для роутеров с физическими USB-портами (USB 2.0 / USB 3.0). Если ваш роутер не оснащен USB или порт пуст, вы можете настроить параметры заранее или установить необходимые системные пакеты."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status / Action Bar -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Обновить состояние" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <!-- Physical USB Devices Scan Summary -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Обнаруженные USB-устройства на шине роутера" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right" CornerRadius="4" Padding="8,2"
                                Background="{Binding HasPhysicalUsb, Converter={StaticResource BooleanToBrushConverter}, FallbackValue=#374151}">
                            <TextBlock Text="{Binding HasPhysicalUsb, Converter={StaticResource BooleanToConnectedTextConverter}, FallbackValue='Порты свободны'}" 
                                       FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding UsbDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Id, StringFormat='VID:PID = {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Background="#3B82F6" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceType}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="На роутере не обнаружено активных USB-устройств. Подключите модем или USB флешку/диск в порт роутера." 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontStyle="Italic"
                               Visibility="{Binding HasPhysicalUsb, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="0,4,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- Tabs: Modems vs Disks -->
            <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,20">
                <!-- TAB 1: USB-МОДЕМЫ -->
                <TabItem Header="📶 USB Модемы (LTE / 4G / 5G / 3G)">
                    <StackPanel Margin="0,16,0,0">
                        <!-- Modem Status Card -->
                        <ui:Card Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Текущее состояние мобильного модема" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Статус линка" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Modem.Status}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Уровень сигнала (RSSI)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Modem.SignalStrength}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="IP адрес модема" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Modem.IpAddress}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Modem Config Form Card -->
                        <ui:Card Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Конфигурация сетевого интерфейса модема (wwan)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Protocol -->
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Протокол модема:" FontWeight="Medium" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding AvailableProtocols}" SelectedItem="{Binding Modem.Protocol}" />
                                        <TextBlock Text="QMI / MBIM для современных LTE/5G модемов; RNDIS для HiLink свистков; 3G для старых USB-донглов" 
                                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Device Node -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Узел устройства (/dev):" FontWeight="Medium" Margin="0,0,0,6" />
                                        <ui:TextBox Text="{Binding Modem.DeviceNode, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Обычно /dev/cdc-wdm0 (QMI/MBIM) или /dev/ttyUSB0 (3G PPP)" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- APN -->
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Точка доступа (APN):" FontWeight="Medium" Margin="0,0,0,6" />
                                        <ui:TextBox Text="{Binding Modem.Apn, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- PDP Type -->
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="Тип PDP (IP стек):" FontWeight="Medium" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding AvailablePdpTypes}" SelectedItem="{Binding Modem.PdpType}" />
                                    </StackPanel>

                                    <!-- PIN Code -->
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="PIN-код SIM (если есть):" FontWeight="Medium" Margin="0,0,0,6" />
                                        <ui:PasswordBox Password="{Binding Modem.PinCode}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Сохранить в /etc/config/network" Command="{Binding SaveModemConfigCommand}" Margin="0,0,10,0" />
                                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Перезапустить интерфейс (ifup wwan)" Command="{Binding RestartModemCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- 1-Click Modem Drivers Package Card -->
                        <ui:Card>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Драйверы и пакеты для модемов (QMI / MBIM / Modeswitch)" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="Установка kmod-usb-net-qmi-wwan, uqmi, kmod-usb-net-cdc-mbim, umbim, usb-modeswitch для автоматического переключения и работы модемов" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" 
                                           Content="Установить драйверы модемов" Command="{Binding InstallModemDriversCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </TabItem>

                <!-- TAB 2: USB-ДИСКИ И ХРАНИЛИЩЕ -->
                <TabItem Header="💾 USB Диски и Хранилище (fstab &amp; Samba)">
                    <StackPanel Margin="0,16,0,0">
                        <!-- Disks List Card -->
                        <ui:Card Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Обнаруженные накопители и разделы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding Disks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Row 0: Node & Filesystem -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Storage24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding DeviceNode}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                                        <Border Background="#3B82F6" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileSystem}" FontWeight="SemiBold" FontSize="11" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Label, StringFormat=' ({0})'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Mount Status Tag -->
                                                    <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                                            Background="{Binding IsMounted, Converter={StaticResource BooleanToBrushConverter}, FallbackValue=#10B981}">
                                                        <TextBlock Text="{Binding IsMounted, Converter={StaticResource BooleanToMountedTextConverter}, FallbackValue='Смонтирован'}" 
                                                                   FontWeight="SemiBold" FontSize="12" Foreground="White" />
                                                    </Border>

                                                    <!-- Row 1: Space Progress Bar & Details -->
                                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding MountPoint, StringFormat='Точка монтирования: {0}'}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold">
                                                                <Run Text="{Binding UsedSize}" />
                                                                <Run Text=" / " />
                                                                <Run Text="{Binding TotalSize}" />
                                                                <Run Text=" (" />
                                                                <Run Text="{Binding UsagePercentage, StringFormat='{}{0:F0}%'}" />
                                                                <Run Text=")" />
                                                            </TextBlock>
                                                        </Grid>
                                                        <ProgressBar Value="{Binding UsagePercentage}" Maximum="100" Height="6" />
                                                    </StackPanel>

                                                    <!-- Row 2: Action Buttons -->
                                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                                                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon FolderAdd24}" Content="Смонтировать" 
                                                                   Command="{Binding DataContext.MountDiskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}" Margin="0,0,8,0"
                                                                   Visibility="{Binding IsMounted, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                                        <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon Dismiss24}" Content="Размонтировать" 
                                                                   Command="{Binding DataContext.UnmountDiskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}" Margin="0,0,8,0"
                                                                   Visibility="{Binding IsMounted, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ShareAndroid24}" Content="Открыть в Samba (LAN общий доступ)" 
                                                                   Command="{Binding DataContext.EnableSambaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Visibility="{Binding IsMounted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Блочные накопители не найдены. Подключите USB-накопитель в порт роутера." 
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontStyle="Italic"
                                           Visibility="{Binding Disks.Count, Converter={StaticResource ZeroCountToVisibilityConverter}, FallbackValue=Visible}" />
                            </StackPanel>
                        </ui:Card>

                        <!-- 1-Click Storage Drivers Package Card -->
                        <ui:Card>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Пакеты для USB-хранилища (fstab, NTFS, ext4, Samba4)" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="Установка block-mount, kmod-usb-storage, файловых систем ext4/NTFS3/vfat и сетевого файлообменника Samba4" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" 
                                           Content="Установить пакеты хранилища" Command="{Binding InstallStorageDriversCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
