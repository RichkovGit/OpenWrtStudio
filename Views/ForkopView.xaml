<UserControl x:Class="OpenWrtStudio.Views.ForkopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="ForkOP &amp; Обход блокировок" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Управление репозиториями ForkOP, компонентами PassWall 2, SmartDNS, ChinaDNS-NG и диагностика обхода" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Banner -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Обновить статус" Command="{Binding LoadDataCommand}" />
                </Grid>
            </Border>

            <!-- Card 1: ForkOP Feed Setup -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Репозиторий пакетов ForkOP" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Предоставляет готовые пакеты PassWall, Sing-box, Xray и DNS-фильтры для вашей архитектуры" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Padding="10,4"
                                Background="{Binding FeedInfo.IsConfigured, Converter={StaticResource BoolToStatusBrushConverter}}">
                            <TextBlock Text="{Binding FeedInfo.IsConfigured, Converter={StaticResource BoolToStatusTextConverter}, ConverterParameter='Подключен|Не настроен'}" 
                                       FontWeight="SemiBold" FontSize="12" Foreground="White" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Архитектура процессора роутера" Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBox Text="{Binding FeedInfo.Architecture, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Статус ключа подписи" Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBox Text="{Binding FeedInfo.FeedKeyStatus, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Подключить ForkOP" 
                                       Command="{Binding ConfigureRepoCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding FeedInfo.FeedUrl, StringFormat='Текущий адрес фида: {0}'}" 
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:Card>

            <!-- Card 2: Components List -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Компоненты и службы обхода блокировок" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    
                    <ItemsControl ItemsSource="{Binding Components}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding PackageName}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="10,0" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border CornerRadius="10" Padding="8,2" Margin="0,0,6,0"
                                                    Background="{Binding IsInstalled, Converter={StaticResource BoolToStatusBrushConverter}}">
                                                <TextBlock Text="{Binding IsInstalled, Converter={StaticResource BoolToStatusTextConverter}, ConverterParameter='Установлен|Не установлен'}" 
                                                           FontSize="11" FontWeight="Medium" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding Version}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="3" Appearance="Secondary" Content="Установить" 
                                                   Command="{Binding DataContext.InstallComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource InverseBooleanConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Card 3: Bypass Diagnostics -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Диагностика обхода блокировок и прозрачного проксирования" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Анализ таблиц nftables/iptables в ядре роутера, перехвата порта 53 и доступности ресурсов" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Stethoscope24}" Content="Запустить тест" 
                                   Command="{Binding RunDiagnosticsCommand}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Russian Sites -->
                        <Border Margin="0,0,8,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Прямой трафик (РФ)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding DiagResult.DirectRussiaOk, Converter={StaticResource BoolToStatusTextConverter}, ConverterParameter='Работает|Сбой'}" 
                                           FontWeight="Bold" FontSize="16" Margin="0,4,0,0"
                                           Foreground="{Binding DiagResult.DirectRussiaOk, Converter={StaticResource BoolToStatusBrushConverter}}" />
                            </StackPanel>
                        </Border>

                        <!-- Blocked Sites Resolution -->
                        <Border Grid.Column="1" Margin="0,0,8,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="DNS обхода блокировок" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding DiagResult.ProxyBypassOk, Converter={StaticResource BoolToStatusTextConverter}, ConverterParameter='Разрешается|Блокируется'}" 
                                           FontWeight="Bold" FontSize="16" Margin="0,4,0,0"
                                           Foreground="{Binding DiagResult.ProxyBypassOk, Converter={StaticResource BoolToStatusBrushConverter}}" />
                            </StackPanel>
                        </Border>

                        <!-- Kernel Rules -->
                        <Border Grid.Column="2" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Правила фильтрации в ядре" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding DiagResult.HasTransparentProxyRules, Converter={StaticResource BoolToStatusTextConverter}, ConverterParameter='Внедрены|Не найдены'}" 
                                           FontWeight="Bold" FontSize="16" Margin="0,4,0,0"
                                           Foreground="{Binding DiagResult.HasTransparentProxyRules, Converter={StaticResource BoolToStatusBrushConverter}}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DiagResult.RuleChainsFound}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ui:SymbolIcon Symbol="Checkmark24" Foreground="#10B981" Margin="0,0,8,0" FontSize="14" />
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
