<UserControl x:Class="OpenWrtStudio.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:OpenWrtStudio.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PeopleCommunity24" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="Управление клиентами сети" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Активные беспроводные и проводные устройства, уровень сигнала, фиксация статических IP и блокировка доступа." 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="38,4,0,0" FontSize="13" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Обновить список" 
                           Command="{Binding LoadClientsCommand}" Margin="0,0,8,0" />
            </StackPanel>
        </Grid>

        <!-- 1: Top KPI Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card: Total -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Всего устройств" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card: Wi-Fi 5 GHz -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Wi-Fi 5 GHz (Быстрый)" Foreground="#00D2FF" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Wifi5Count}" FontSize="24" FontWeight="Bold" Foreground="#00D2FF" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card: Wi-Fi 2.4 GHz -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Wi-Fi 2.4 GHz" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Wifi24Count}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card: LAN -->
            <Border Grid.Column="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Проводные (LAN)" Foreground="#8B5CF6" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LanCount}" FontSize="24" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card: Blocked -->
            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Заблокировано" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BlockedCount}" FontSize="24" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2: Search and Category Filter Toolbar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <ui:TextBox Grid.Column="0" Icon="{ui:SymbolIcon Search24}" PlaceholderText="Поиск по имени, IP, MAC..." 
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Filter Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Все" Appearance="{Binding SelectedFilter, Converter={StaticResource EqualStringToAppearanceConverter}, ConverterParameter='Все'}" 
                               Command="{Binding SetFilterCommand}" CommandParameter="Все" Margin="0,0,6,0" />
                    <ui:Button Content="⚡ 5 GHz" Appearance="{Binding SelectedFilter, Converter={StaticResource EqualStringToAppearanceConverter}, ConverterParameter='5 GHz'}" 
                               Command="{Binding SetFilterCommand}" CommandParameter="5 GHz" Margin="0,0,6,0" />
                    <ui:Button Content="📶 2.4 GHz" Appearance="{Binding SelectedFilter, Converter={StaticResource EqualStringToAppearanceConverter}, ConverterParameter='2.4 GHz'}" 
                               Command="{Binding SetFilterCommand}" CommandParameter="2.4 GHz" Margin="0,0,6,0" />
                    <ui:Button Content="🔌 LAN" Appearance="{Binding SelectedFilter, Converter={StaticResource EqualStringToAppearanceConverter}, ConverterParameter='LAN'}" 
                               Command="{Binding SetFilterCommand}" CommandParameter="LAN" Margin="0,0,6,0" />
                    <ui:Button Content="🚫 Заблокированные" Appearance="{Binding SelectedFilter, Converter={StaticResource EqualStringToAppearanceConverter}, ConverterParameter='Заблокировано'}" 
                               Command="{Binding SetFilterCommand}" CommandParameter="Заблокировано" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3: Client Cards List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredClients}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NetworkClient}">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Icon & Status Dot -->
                                <Grid Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <ui:SymbolIcon Symbol="Laptop24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Ellipse Width="10" Height="10" Fill="#10B981" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                                </Grid>

                                <!-- Column 1: Device Name & Band Badge -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                                        <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" Background="{Binding BandBadgeColor}">
                                            <TextBlock Text="{Binding Band}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MacAddress}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontFamily="Consolas" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Column 2: IP Address & Static Lease Status -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IpAddress}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Consolas" />
                                        <ui:Button Icon="{ui:SymbolIcon Copy20}" Appearance="Transparent" Padding="4,0" Height="20"
                                                   Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding IpAddress}" ToolTip="Копировать IP" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding IsStaticLease, Converter={StaticResource BoolToStaticTextConverter}}" 
                                               Foreground="{Binding IsStaticLease, Converter={StaticResource BoolToStaticBrushConverter}}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Column 3: Signal Quality & Bitrates -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SignalQuality}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding RxBitrate, StringFormat='Rx: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding TxBitrate, StringFormat='Tx: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Column 4: Blocked Badge & Uptime -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Border CornerRadius="4" Padding="8,2" Background="#EF4444" Visibility="{Binding IsBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="ДОСТУП В ИНТЕРНЕТ ЗАБЛОКИРОВАН" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding ConnectedDuration, StringFormat='В сети: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               Visibility="{Binding ConnectedDuration, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Column 5: Action Buttons -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Disconnect / Kick button -->
                                    <ui:Button Icon="{ui:SymbolIcon PlugDisconnected20}" Appearance="Secondary" Content="Сбросить" ToolTip="Отключить устройство от Wi-Fi" 
                                               Command="{Binding DataContext.KickClientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" Margin="0,0,6,0" />

                                    <!-- Static IP Button -->
                                    <ui:Button Icon="{ui:SymbolIcon Pin20}" Appearance="Secondary" Content="Фикс. IP" ToolTip="Закрепить статический IP в DHCP" 
                                               Command="{Binding DataContext.OpenStaticDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" Margin="0,0,6,0" />

                                    <!-- Block / Unblock Button -->
                                    <ui:Button Appearance="{Binding IsBlocked, Converter={StaticResource BlockToAppearanceConverter}}" 
                                               Content="{Binding IsBlocked, Converter={StaticResource BlockToTextConverter}}"
                                               Command="{Binding DataContext.ToggleBlockInternetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4: Bottom Status Bar -->
        <Border Grid.Row="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,6" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <ui:ProgressRing Grid.Column="1" IsIndeterminate="True" Width="16" Height="16" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- MODAL DIALOG: STATIC DHCP LEASE RESERVATION -->
        <Grid Grid.RowSpan="5" Background="#80000000" Visibility="{Binding IsStaticDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="450" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Pin24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="Резервирование статического IP" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Назначьте постоянный IP-адрес для устройства в сервисе dnsmasq на роутере:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <TextBlock Text="MAC-адрес устройства:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding DialogClient.MacAddress}" IsReadOnly="True" Margin="0,0,0,12" FontFamily="Consolas" />

                    <TextBlock Text="Пользовательское имя (Alias):" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding DialogCustomName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Например: Ноутбук_Данила" Margin="0,0,0,12" />

                    <TextBlock Text="Фиксированный IP-адрес:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding DialogStaticIp, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="192.168.10.150" Margin="0,0,0,20" FontFamily="Consolas" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Отмена" Appearance="Secondary" Command="{Binding CloseStaticDialogCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Сохранить и привязать" Appearance="Primary" Command="{Binding SaveStaticLeaseCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
