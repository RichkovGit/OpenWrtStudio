<UserControl x:Class="OpenWrtStudio.Views.MihomoBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="980">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Конструктор конфигурации Mihomo (Clash.Meta)" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Полный визуальный редактор параметров ядра: TUN режим, Fake-IP DNS, Proxy Groups, сниффер и правила" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Main Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Импорт" Command="{Binding ImportFromFileCommand}" Margin="0,0,8,0" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowUpload24}" Content="Экспорт" Command="{Binding ExportToFileCommand}" Margin="0,0,8,0" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon CloudArrowDown24}" Content="Стянуть с роутера" Command="{Binding FetchFromRouterCommand}" Margin="0,0,8,0" />
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Send24}" Content="Применить на роутере" Command="{Binding DeployToRouterCommand}" />
            </StackPanel>
        </Grid>

        <!-- Presets & Status Bar -->
        <ui:Card Grid.Row="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Быстрые пресеты:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Flash24}" Content="⚡ Умный обход (Антизапрет + RU напрямую)" Command="{Binding ApplyAntizapretPresetCommand}" Margin="0,0,8,0" />
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Globe24}" Content="🌐 Полный туннель" Command="{Binding ApplyFullTunnelPresetCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding BuilderStatus}" VerticalAlignment="Center" Margin="16,0" 
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Путь: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ui:TextBox Width="180" Text="{Binding DeployRemotePath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Main Configuration Tabs -->
        <TabControl Grid.Row="2">
            <!-- TAB 0: Внедрение подписок (Proxy Providers) -->
            <TabItem Header="Подписки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <ui:Card Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Внедрение подписки в конфигурацию (Subscription &amp; Proxy Providers)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Автоматическое подключение внешней ссылки на подписку прокси (Clash / Mihomo URL). Роутер будет автоматически обновлять список серверов и тестировать их задержку." 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Ссылка на подписку (Subscription URL)" Margin="0,0,0,4" FontWeight="Medium" />
                                        <ui:TextBox Text="{Binding SubscriptionUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://my-proxy-sub.com/api/v1/client/subscribe?token=..." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Имя провайдера" Margin="0,0,0,4" FontWeight="Medium" />
                                        <ui:TextBox Text="{Binding SubscriptionName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="my-sub" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Автообновление (ч)" Margin="0,0,0,4" FontWeight="Medium" />
                                        <ui:TextBox Text="{Binding SubscriptionIntervalHours, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Внедрить подписку в конфиг" 
                                               Command="{Binding InjectSubscriptionCommand}" Margin="0,0,10,0" />
                                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Обновить подписку на роутере прямо сейчас" 
                                               Command="{Binding UpdateSubscriptionOnRouterCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Active Subscriptions / Providers List -->
                        <ui:Card Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Активные подписки в конфигурации" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding ProxyProviders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value.Url}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Value.Interval, StringFormat='Интервал: {0}с'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 1: Общие параметры -->
            <TabItem Header="Общие">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <ui:Card Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Сетевые порты и режим работы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Смешанный порт (Mixed-Port)" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding MixedPort, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="SOCKS5 + HTTP в одном порту" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Margin="5,0,5,0">
                                        <TextBlock Text="Redir-Port" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding RedirPort, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Порт прозрачного TCP-прокси" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="TProxy-Port" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding TproxyPort, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Порт прозрачного UDP-прокси" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </UniformGrid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Режим маршрутизации (Mode)" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding Mode}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Rule (По правилам)" Tag="rule" IsSelected="True" />
                                            <ComboBoxItem Content="Global (Весь трафик через прокси)" Tag="global" />
                                            <ComboBoxItem Content="Direct (Прямое подключение)" Tag="direct" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                        <TextBlock Text="Уровень журнала (Log Level)" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding LogLevel}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Info (Стандартный)" Tag="info" IsSelected="True" />
                                            <ComboBoxItem Content="Warning (Только предупреждения)" Tag="warning" />
                                            <ComboBoxItem Content="Error (Только ошибки)" Tag="error" />
                                            <ComboBoxItem Content="Debug (Отладка)" Tag="debug" />
                                            <ComboBoxItem Content="Silent (Без логов)" Tag="silent" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="Адрес привязки (Bind)" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding BindAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,14,0,0">
                                    <ui:ToggleSwitch Content="Разрешить доступ из LAN" IsChecked="{Binding AllowLan}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Поддержка IPv6" IsChecked="{Binding Ipv6}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Параллельные TCP (tcp-concurrent)" IsChecked="{Binding TcpConcurrent}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Унифицированная задержка" IsChecked="{Binding UnifiedDelay}" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Панель управления (Web UI) и Controller" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="External Controller (IP:Port)" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding ExternalController, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                        <TextBlock Text="Секретный токен (Secret)" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Оставьте пустым или укажите токен" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="Веб-панель (External UI)" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding ExternalUi}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="MetaCubeX Dashboard" Tag="metacubexd" IsSelected="True" />
                                            <ComboBoxItem Content="Zashboard" Tag="zashboard" />
                                            <ComboBoxItem Content="YACD Dashboard" Tag="yacd" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="Базы геоданных (GeoIP / GeoSite)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <ui:ToggleSwitch Content="Режим геоданных (geodata-mode)" IsChecked="{Binding GeodataMode}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Автообновление баз" IsChecked="{Binding GeoAutoUpdate}" Margin="0,0,24,0" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Интервал (часов): " VerticalAlignment="Center" />
                                        <ui:TextBox Width="60" Text="{Binding GeoUpdateInterval, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: TUN режим -->
            <TabItem Header="TUN режим">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="Виртуальный сетевой интерфейс TUN" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Позволяет прозрачно перенаправлять весь трафик устройств локальной сети без ручной настройки прокси на клиентах" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />

                                <WrapPanel>
                                    <ui:ToggleSwitch Content="Включить режим TUN (enable)" IsChecked="{Binding TunEnable}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Автомаршрутизация (auto-route)" IsChecked="{Binding TunAutoRoute}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Автоопределение интерфейса" IsChecked="{Binding TunAutoDetectInterface}" Margin="0,0,24,0" />
                                </WrapPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Сетевой стек (Stack)" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding TunStack}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Mixed (Рекомендуется)" Tag="mixed" IsSelected="True" />
                                            <ComboBoxItem Content="System (Ядро Linux)" Tag="system" />
                                            <ComboBoxItem Content="gVisor (Пользовательское пространство)" Tag="gvisor" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                        <TextBlock Text="Имя устройства (Device)" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding TunDevice, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="Размер MTU" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding TunMtu, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,14,0,0">
                                    <ui:ToggleSwitch Content="Строгая маршрутизация (strict-route)" IsChecked="{Binding TunStrictRoute}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Endpoint-independent NAT" IsChecked="{Binding TunEndpointIndependentNat}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Авто-редирект (auto-redirect)" IsChecked="{Binding TunAutoRedirect}" />
                                </WrapPanel>

                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Перехват DNS трафика роутера (dns-hijack):" Margin="0,0,0,4" FontWeight="Medium" />
                                    <ui:TextBox Height="60" AcceptsReturn="True" Text="{Binding TunDnsHijack, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Укажите адреса для перехвата (по одному на строку, например: any:53, tcp://any:53)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: DNS Движок -->
            <TabItem Header="DNS Движок">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="Встроенный высокоскоростной DNS" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:ToggleSwitch Content="Включить DNS" IsChecked="{Binding DnsEnable}" VerticalAlignment="Center" Margin="0,0,24,0" />

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Порт прослушивания (Listen)" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding DnsListen, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="Режим (Enhanced Mode)" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding DnsEnhancedMode}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Fake-IP (Быстрый обход без ожидания DNS)" Tag="fake-ip" IsSelected="True" />
                                            <ComboBoxItem Content="Redir-Host (Реальный DNS)" Tag="redir-host" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Диапазон Fake-IP (Fake-IP Range)" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding DnsFakeIpRange, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Default Nameservers (Bootstrap DNS)" Margin="0,0,0,4" />
                                        <ui:TextBox Height="60" AcceptsReturn="True" Text="{Binding DnsDefaultNameservers, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Основные вышестоящие серверы (Nameserver):" FontWeight="Medium" Margin="0,0,0,4" />
                                        <ui:TextBox Height="90" AcceptsReturn="True" Text="{Binding DnsNameservers, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="DoH/DoT адреса (Yandex, Cloudflare, Google)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Резервные серверы (Fallback DNS):" FontWeight="Medium" Margin="0,0,0,4" />
                                        <ui:TextBox Height="90" AcceptsReturn="True" Text="{Binding DnsFallbacks, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Используются при сбоях или геоблокировках" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Исключения из Fake-IP (Fake-IP Filter):" FontWeight="Medium" Margin="0,0,0,4" />
                                    <ui:TextBox Height="70" AcceptsReturn="True" Text="{Binding DnsFakeIpFilters, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Домены локальной сети, NTP серверов времени и проверки сетевого подключения" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: Сниффер -->
            <TabItem Header="Сниффер пакетов">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="Сниффинг и анализ доменных имен (Sniffer)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Извлекает истинные имена доменов из SNI заголовков TLS и HTTP пакетов для точной маршрутизации" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />

                                <WrapPanel>
                                    <ui:ToggleSwitch Content="Включить сниффер (enable)" IsChecked="{Binding SnifferEnable}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Анализ чистых IP (parse-pure-ip)" IsChecked="{Binding SnifferParsePureIp}" Margin="0,0,24,0" />
                                    <ui:ToggleSwitch Content="Перезапись адреса" IsChecked="{Binding SnifferOverrideDestination}" />
                                </WrapPanel>

                                <TextBlock Text="Протоколы анализа:" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <WrapPanel>
                                    <CheckBox Content="HTTP (порты 80, 8080)" IsChecked="{Binding SniffHttp}" Margin="0,0,24,0" />
                                    <CheckBox Content="TLS / HTTPS (порты 443, 8443)" IsChecked="{Binding SniffTls}" Margin="0,0,24,0" />
                                    <CheckBox Content="QUIC / HTTP3 (порт 443)" IsChecked="{Binding SniffQuic}" />
                                </WrapPanel>

                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Исключения сниффера (Skip Domain):" Margin="0,0,0,4" />
                                    <ui:TextBox Height="60" AcceptsReturn="True" Text="{Binding SnifferSkipDomains, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: Группы прокси -->
            <TabItem Header="Группы прокси">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Создать новую группу прокси" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Имя группы (например PROXY)" Margin="0,0,8,0" />

                                <ComboBox Grid.Column="1" SelectedValue="{Binding NewGroupType}" SelectedValuePath="Tag" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Select (Ручной выбор)" Tag="select" IsSelected="True" />
                                    <ComboBoxItem Content="URL-Test (Авто по пингу)" Tag="url-test" />
                                    <ComboBoxItem Content="Fallback (Резерв)" Tag="fallback" />
                                    <ComboBoxItem Content="Load-Balance (Балансир)" Tag="load-balance" />
                                </ComboBox>

                                <ui:TextBox Grid.Column="2" Text="{Binding NewGroupProxies, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ноды через запятую (например AUTO-SPEED, DIRECT)" Margin="0,0,8,0" />

                                <ui:Button Grid.Column="3" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Добавить" Command="{Binding AddProxyGroupCommand}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1">
                        <DataGrid ItemsSource="{Binding ProxyGroups}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  RowHeight="36" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя группы" Binding="{Binding Name}" Width="180" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120" />
                                <DataGridTextColumn Header="Ноды / Подключения" Binding="{Binding Proxies.Count, StringFormat='{}{0} нод'}" Width="150" />
                                <DataGridTextColumn Header="URL проверки" Binding="{Binding Url}" Width="*" />
                                <DataGridTemplateColumn Header="Удалить" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Appearance="Danger" Content="Удалить" 
                                                       Command="{Binding DataContext.RemoveProxyGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- TAB 6: Правила маршрутизации -->
            <TabItem Header="Правила маршрутизации">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Добавить правило маршрутизации" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox SelectedValue="{Binding NewRuleType}" SelectedValuePath="Content" Margin="0,0,8,0">
                                    <ComboBoxItem Content="GEOSITE" IsSelected="True" />
                                    <ComboBoxItem Content="GEOIP" />
                                    <ComboBoxItem Content="DOMAIN-SUFFIX" />
                                    <ComboBoxItem Content="DOMAIN-KEYWORD" />
                                    <ComboBoxItem Content="IP-CIDR" />
                                    <ComboBoxItem Content="RULE-SET" />
                                    <ComboBoxItem Content="MATCH" />
                                </ComboBox>

                                <ui:TextBox Grid.Column="1" Text="{Binding NewRulePayload, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Значение (например youtube, antizapret, RU)" Margin="0,0,8,0" />

                                <ui:TextBox Grid.Column="2" Text="{Binding NewRuleTarget, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Цель (PROXY, DIRECT)" Margin="0,0,8,0" />

                                <CheckBox Grid.Column="3" Content="no-resolve" IsChecked="{Binding NewRuleNoResolve}" Margin="0,0,12,0" VerticalAlignment="Center" />

                                <ui:Button Grid.Column="4" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Добавить правило" Command="{Binding AddRuleCommand}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Rules}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  RowHeight="36" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Тип правила" Binding="{Binding RuleType}" Width="150" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Значение" Binding="{Binding Payload}" Width="*" />
                                <DataGridTextColumn Header="Целевая группа" Binding="{Binding Target}" Width="180" FontWeight="SemiBold" />
                                <DataGridCheckBoxColumn Header="No-Resolve" Binding="{Binding NoResolve}" Width="100" />
                                <DataGridTemplateColumn Header="Порядок" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ChevronUp24}" Margin="0,0,4,0"
                                                           Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ChevronDown24}" 
                                                           Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Удалить" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Appearance="Danger" Content="X" 
                                                       Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- TAB 7: YAML предпросмотр -->
            <TabItem Header="YAML файл (Предпросмотр)">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Готовый файл конфигурации для Mihomo / Clash.Meta:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" Content="Обновить YAML из формы" Command="{Binding GenerateYamlCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Edit24}" Content="Применить правки в форму" Command="{Binding SyncFromYamlCommand}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Row="1" Background="#111827">
                        <TextBox Text="{Binding YamlContent, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="#E0E7FF" BorderThickness="0"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13" />
                    </ui:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
